# Booking
# Production booking is hard-coded to the Integral Values Calendly event URLs.
# No booking-provider secret is required by the website.

# Temporary Supabase configuration during data/auth migration.
# Remove these variables when the MariaDB/Infomaniak replacement is validated.
VITE_SUPABASE_URL=https://example.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-public-key
SUPABASE_URL=https://example.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-public-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret

# Authentication email adapter
# Disabled by default. Enable only after an independent provider endpoint is selected and tested.
EMAIL_PROVIDER=disabled
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
AUTH_EMAIL_WEBHOOK_SECRET=
EMAIL_PREVIEW_TOKEN=
