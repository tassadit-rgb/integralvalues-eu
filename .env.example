# Client-visible booking configuration
# Safe default until Amelia production validation is complete.
VITE_BOOKING_PROVIDER=calendly
VITE_AMELIA_PUBLIC_BASE_URL=https://booking.example.test/

# Supabase public client configuration
VITE_SUPABASE_URL=https://example.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-public-key

# Supabase server-only configuration
SUPABASE_URL=https://example.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-public-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret

# Authentication email adapter
# Leave disabled until a provider endpoint has been selected and tested.
EMAIL_PROVIDER=disabled
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
AUTH_EMAIL_WEBHOOK_SECRET=
EMAIL_PREVIEW_TOKEN=
